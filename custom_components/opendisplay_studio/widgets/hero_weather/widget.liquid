{% assign weather = data.heroWeather %}
<div class="od-hero-weather" style="--hero-primary:{{ config.primaryColor }};--hero-accent:{{ config.accentColor }}">
  <div class="od-hero-weather__current">
    <strong class="od-hero-weather__temperature">{{ weather.temperature }}{% if weather.temperature != "—" %}°{% endif %}</strong>
    <span class="od-hero-weather__condition">{{ weather.condition }}</span>
  </div>
  <div class="od-hero-weather__range">
    {% if weather.high != nil %}<span class="od-hero-weather__high">↑ {{ weather.high | round }}°</span>{% endif %}
    {% if weather.low != nil %}<span class="od-hero-weather__low">↓ {{ weather.low | round }}°</span>{% endif %}
  </div>
</div>

<style>
  .od-hero-weather {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 4cqw, 30px);
    padding: clamp(8px, 4cqh, 24px);
    box-sizing: border-box;
    overflow: hidden;
    color: var(--hero-primary);
    text-align: center;
  }

  .od-hero-weather__current {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .od-hero-weather__temperature {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-family, sans-serif);
    font-size: clamp(48px, 48cqh, 180px);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.055em;
  }

  .od-hero-weather__condition {
    max-width: 100%;
    margin-top: clamp(4px, 3cqh, 14px);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: clamp(14px, 11cqh, 36px);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .od-hero-weather__range {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(4px, 3cqh, 12px);
    font-size: clamp(16px, 14cqh, 42px);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .od-hero-weather__high {
    color: var(--hero-accent);
  }

  .od-hero-weather__low {
    color: var(--hero-primary);
  }

  @container od-region (max-aspect-ratio: 4 / 5) {
    .od-hero-weather {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .od-hero-weather__range {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>
