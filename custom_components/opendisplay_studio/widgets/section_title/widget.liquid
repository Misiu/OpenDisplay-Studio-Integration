{% assign title = data.sectionTitle %}
<div class="od-section-title">
  <strong class="od-section-title__weekday" style="color:{{ config.weekdayColor }}">{{ title.weekday }}</strong>
  <span class="od-section-title__date" style="color:{{ config.dateColor }}">{{ title.date }}</span>
</div>

<style>
  .od-section-title {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(2px, 2cqh, 10px);
    padding: clamp(6px, 5cqh, 20px);
    box-sizing: border-box;
    overflow: hidden;
    text-transform: uppercase;
  }

  .od-section-title__weekday,
  .od-section-title__date {
    display: block;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-family, sans-serif);
    font-weight: 800;
    line-height: 0.92;
  }

  .od-section-title__weekday {
    font-size: clamp(18px, 30cqh, 58px);
  }

  .od-section-title__date {
    font-size: clamp(13px, 21cqh, 38px);
  }
</style>
