{
  "name": "opendisplay-studio-ha-panel",
  "private": true,
  "version": "3.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:e2e": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:types",
    "lint:eslint": "eslint src e2e --max-warnings=0",
    "lint:prettier": "prettier . --check",
    "lint:types": "tsc --noEmit",
    "format": "eslint src e2e --fix && prettier . --write"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.11.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^4.0.18"
  }
}
