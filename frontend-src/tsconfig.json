{
  "compilerOptions": {
    "target": "es2023",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/ods-app.ts",
    "src/ods-canvas.ts",
    "src/ods-code-view.ts",
    "src/ods-context-menu.ts",
    "src/ods-gallery.ts",
    "src/ods-header.ts",
    "src/ods-inspector.ts",
    "src/ods-library.ts",
    "src/ods-new-dashboard-dialog.ts",
    "src/ods-property-field.ts",
    "src/ods-structure.ts",
    "src/ods-zoom-bar.ts",
    "src/types.ts",
    "src/catalog.ts",
    "src/dashboard-ops.ts",
    "src/dashboards.ts",
    "src/events.ts",
    "src/geometry.ts",
    "src/history.ts",
    "src/item-fields.ts",
    "src/item-labels.ts",
    "src/math.ts",
    "src/pointer-gesture.ts",
    "src/studio-styles.ts",
    "src/viewport.ts",
    "src/dev.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
